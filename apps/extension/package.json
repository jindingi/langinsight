{
  "name": "@langinsight/extension",
  "description": "A Chrome extension that helps you understand words and sentences by showing their meanings when you select text on any webpage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "get-chrome-debugging-port": "python3 scripts/get_chrome_debugging_port.py",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "precompile_template": "pnpm dlx handlebars src/prompts/*.handlebars -f /tmp/templates.precompiled.ts && echo \"import Handlebars from \\\"handlebars\\\";\" | cat - /tmp/templates.precompiled.ts > src/prompts/templates.precompiled.ts",
    "predev": "pnpm precompile_template",
    "prebuild": "pnpm precompile_template"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.16",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tailwindcss/vite": "^4.1.11",
    "@webext-core/messaging": "^2.3.0",
    "ai": "^5.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "embla-carousel-react": "^8.6.0",
    "handlebars": "^4.7.8",
    "jotai": "^2.12.5",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.532.0",
    "openai": "^5.12.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "sbd": "^1.0.19",
    "streamdown": "^1.0.11",
    "tailwind-merge": "^3.3.1",
    "use-stick-to-bottom": "^1.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sbd": "^1.0.5",
    "@vitejs/plugin-react": "^5.0.1",
    "@wxt-dev/module-react": "^1.1.3",
    "wxt": "^0.20.6"
  }
}