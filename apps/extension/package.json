{
  "name": "@langinsight/extension",
  "description": "A Chrome extension that helps you understand words and sentences by showing their meanings when you select text on any webpage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "get-chrome-debugging-port": "python3 scripts/get_chrome_debugging_port.py",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "@webext-core/messaging": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "handlebars": "^4.7.8",
    "jotai": "^2.12.5",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.532.0",
    "openai": "^5.12.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sbd": "^1.0.19",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/sbd": "^1.0.5",
    "@vitejs/plugin-react": "^5.0.1",
    "@wxt-dev/module-react": "^1.1.3",
    "wxt": "^0.20.6"
  }
}